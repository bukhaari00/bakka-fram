# Bakka Farm Management System - Environment Variables Example
# Used by Railway, Vercel, Docker, and Local Development

NODE_ENV=production
PORT=4000

# PostgreSQL Connection String (Provided by Railway PostgreSQL or Neon)
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# Secret key used for session signing and tokens (Generate a long random string in production)
SESSION_SECRET="replace-with-a-secure-random-64-character-string"

# Frontend Application Origin (For CORS protection)
# Examples: "https://test-app-ashy-phi.vercel.app" or "http://localhost:3000"
APP_ORIGIN="https://test-app-ashy-phi.vercel.app"

# Offline session retention limit in days
OFFLINE_SESSION_MAX_DAYS=7

# Bootstrap Administrator (Initial creation if database is empty)
BOOTSTRAP_ADMIN_EMAIL=admin@bakkafarm.com
BOOTSTRAP_ADMIN_PASSWORD=BakkaAdminSecure2026!
BOOTSTRAP_ADMIN_NAME="Bakka Farm Administrator"
